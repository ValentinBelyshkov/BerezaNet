<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent">

<androidx.camera.view.PreviewView
    android:id="@+id/preview_view"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="invisible" />

<com.edgedetection.opengl.EdgeDetectionGLView
    android:id="@+id/camera_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<!-- AR overlay: SurfaceView для Filament -->
<SurfaceView
    android:id="@+id/ar_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<!-- Оверлей траекторий (поверх AR) -->
<com.edgedetection.ui.battle.BulletTrajectoryView
    android:id="@+id/bullet_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<ImageView
    android:id="@+id/offscreen_indicator"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:src="@drawable/ic_arrow"
    android:visibility="gone"
    android:layout_gravity="center" />

<TextView
    android:id="@+id/gps_warning"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="GPS недоступен — последняя известная позиция"
    android:textColor="#FF4444"
    android:textSize="14sp"
    android:background="#CC000000"
    android:padding="8dp"
    android:visibility="gone"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginTop="24dp" />

<!-- Маркер калибровочной точки (появляется при тапе) -->
<ImageView
    android:id="@+id/calibration_marker"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:src="@drawable/ic_crosshair"
    android:visibility="gone"
    android:contentDescription="Точка упреждения" />

<!-- RTSP Custom Streaming UI Container -->
<FrameLayout
    android:id="@+id/rtsp_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="#000000">

    <VideoView
        android:id="@+id/rtsp_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/rtsp_error_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#AA000000"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/rtsp_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/rtsp_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="16sp"
            android:gravity="center"
            android:text="Подключение... " />

        <TextView
            android:id="@+id/rtsp_retry_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:text="Повторная попытка через 3 сек..."
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

<!-- Кнопка калибровки -->
<android.widget.Button
    android:id="@+id/calibrate_button"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_gravity="start|bottom"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="40dp"
    android:background="#CC000000"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="Калибровка"
    android:contentDescription="Калибровка" />

<!-- Кнопка переключения камеры -->
<android.widget.Button
    android:id="@+id/switch_camera_button"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_gravity="start|bottom"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="96dp"
    android:background="#CC000000"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="Смена камеры"
    android:contentDescription="Смена камеры" />

<!-- Кнопка переключения обработки (Edge Detector) -->
<android.widget.Button
    android:id="@+id/toggle_edges_button"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_gravity="start|bottom"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="152dp"
    android:background="#CC000000"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="Обработка: Выкл"
    android:contentDescription="Переключение обработки" />

<!-- Кнопка огня -->
    <ImageButton
        android:id="@+id/fire_button"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_fire_button"
        android:src="@android:drawable/ic_menu_send"
        android:tint="#FFFFFF"
        android:contentDescription="Огонь" />

    <!-- VIT Info overlay -->
    <TextView
        android:id="@+id/vit_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="48dp"
        android:textColor="#00FF00"
        android:textSize="11sp"
        android:background="#AA000000"
        android:padding="6dp"
        android:visibility="visible"
        android:contentDescription="VIT Информация" />

</FrameLayout>