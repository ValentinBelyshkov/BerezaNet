<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки миссии"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#333333"/>

    <!-- Lives -->
    <TextView
        android:id="@+id/tv_lives_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Количество жизней: 3"
        android:textSize="18sp"
        android:textColor="#333333"/>

    <SeekBar
        android:id="@+id/sb_lives"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="3"
        android:layout_marginBottom="16dp"/>

    <!-- Speed -->
    <TextView
        android:id="@+id/tv_speed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скорость (км/ч): 200"
        android:textSize="18sp"
        android:textColor="#333333"/>

    <SeekBar
        android:id="@+id/sb_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="500"
        android:progress="200"
        android:layout_marginBottom="16dp"/>

    <!-- Altitude -->
    <TextView
        android:id="@+id/tv_altitude_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Высота (м): 100"
        android:textSize="18sp"
        android:textColor="#333333"/>

    <SeekBar
        android:id="@+id/sb_altitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="100"
        android:layout_marginBottom="16dp"/>

    <!-- Spawn Interval -->
    <TextView
        android:id="@+id/tv_spawn_interval_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Интервал появления (сек): 90"
        android:textSize="18sp"
        android:textColor="#333333"/>

    <SeekBar
        android:id="@+id/sb_spawn_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="300"
        android:progress="90"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
