<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки миссии"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#333333"/>


    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Lives -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_lives_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Количество жизней: 3"
                android:textSize="14sp"
                android:textColor="#333333"/>

            <SeekBar
                android:id="@+id/sb_lives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="3"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Скорость (км/ч): 200"
                android:textSize="14sp"
                android:textColor="#333333"/>

            <SeekBar
                android:id="@+id/sb_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="500"
                android:progress="200"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Altitude -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_altitude_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Высота (м): 100"
                android:textSize="14sp"
                android:textColor="#333333"/>

            <SeekBar
                android:id="@+id/sb_altitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Spawn Interval -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_spawn_interval_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Интервал появления (сек): 90"
                android:textSize="14sp"
                android:textColor="#333333"/>

            <SeekBar
                android:id="@+id/sb_spawn_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="90"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </GridLayout>

    <!-- Sound Effects -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Звуковые сигналы (приближение/попадание)"
            android:textSize="14sp"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_sound_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:textColor="#333333"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
